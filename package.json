{
  "name": "@jermainee/credit-card-generator",
  "version": "2.0.0",
  "description": "Generate Luhn-valid credit card numbers with vendor-specific prefixes for testing purposes",
  "keywords": [
    "credit-card",
    "credit-card-generator",
    "card-number",
    "luhn",
    "test-data",
    "fake",
    "generator",
    "typescript"
  ],
  "homepage": "https://github.com/jermainee/credit-card-generator#readme",
  "bugs": {
    "url": "https://github.com/jermainee/credit-card-generator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jermainee/credit-card-generator.git"
  },
  "license": "ISC",
  "author": "Jermaine J. Ernst",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:package": "publint --strict && attw --pack .",
    "check": "npm run typecheck && npm run test:coverage && npm run lint:package",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@vitest/coverage-v8": "^5.0.5",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
